# -------------------------------------------------------
# Frontend-only environment variables (Vite exposes VITE_*
# to the browser at BUILD time — never put secrets here).
# -------------------------------------------------------
#
# Local development fallback (the app uses this when the var
# is unset, e.g. `npm run dev`):
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# Vercel / production: DO NOT rely on the localhost fallback.
# Set VITE_API_BASE_URL in your Vercel Project Settings
# (Environment Variables -> Production) to the deployed
# backend origin, e.g.:
#   VITE_API_BASE_URL=https://currencyx-backend.onrender.com/api/v1
# It must be an absolute URL (scheme + host). Never a
# 127.0.0.1 / localhost address from a deployed environment.
#
# This is the ONLY client-side variable exposed. The Razorpay
# secret key, OpenAI key, JWT secret and database password stay
# on the backend and are never sent to the browser.

