# PostgreSQL connection string for the CurrencyX AI backend.
# Copy this file to ".env" and replace YOUR_PASSWORD with your actual
# PostgreSQL password for the "postgres" user.
# Use YOUR actual PostgreSQL password/port. The database 'currencyx' will be
# created automatically? No — create it once with: CREATE DATABASE currencyx;
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/currencyx

# JWT signing secret for authentication (change in any shared environment)
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay TEST MODE credentials (https://dashboard.razorpay.com/app/keys)
# NEVER put the secret key in any frontend environment file.
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Razorpay DEMO MODE — when true the app simulates payments (demo_order_*/demo_payment_*
# ids) and does NOT require valid Razorpay credentials. Set to false only when you
# have real TEST keys below.
RAZORPAY_DEMO_MODE=true

# CORS origins allowed to call this API (comma-separated).
# Keep this an explicit allowlist — never use "*" with credentials.
# Include any Vite dev ports you actually use (Vite uses 5174 if 5173 is taken).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---------------------------------------------------------------------------
# Optional AI / LLM explanation layer (ONLY enhances explanations; the
# deterministic engine remains the source of truth).
#   AI_ENABLED=false          → deterministic advisor only (recommended default).
#   AI_PROVIDER=openai        → requires OPENAI_API_KEY.
#   AI_PROVIDER=ollama        → free/local LLM, no key (default when unset).
#   AI_PROVIDER=huggingface   → free tier, HUGGINGFACE_API_KEY optional.
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct