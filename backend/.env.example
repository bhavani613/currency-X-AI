# PostgreSQL connection string for the CurrencyX AI backend.
# Copy this file to ".env" and replace YOUR_PASSWORD with your actual
# PostgreSQL password for the "postgres" user.
# Use YOUR actual PostgreSQL password/port. The database 'currencyx' will be
# created automatically? No — create it once with: CREATE DATABASE currencyx;
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/currencyx

# JWT signing secret for authentication (change in any shared environment)
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay TEST MODE credentials (https://dashboard.razorpay.com/app/keys)
# NEVER put the secret key in any frontend environment file.
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret